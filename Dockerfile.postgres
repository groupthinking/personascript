# PersonaScript PostgreSQL Database Dockerfile
FROM postgres:15-alpine

# Environment variables
ENV POSTGRES_DB=personascript_db
ENV POSTGRES_USER=personascript
ENV POSTGRES_PASSWORD=personascript_password

# Copy initialization schema script to docker-entrypoint-initdb.d
COPY src/backend/migrations/schema.sql /docker-entrypoint-initdb.d/01-init.sql

EXPOSE 5432
